{
  "name": "vvsu-tweaks",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Tampermonkey-скрипт с улучшениями для сайтов ВВГУ",
  "author": "siNeZix",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/siNeZix/vvsu-tweaks#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siNeZix/vvsu-tweaks.git"
  },
  "bugs": {
    "url": "https://github.com/siNeZix/vvsu-tweaks/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "check": "npm run typecheck && npm test && npm run build && node scripts/assert-version-sync.mjs --dist",
    "version:check": "node scripts/assert-version-sync.mjs",
    "preversion": "npm run typecheck && npm test",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/tampermonkey": "^5.0.4",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-monkey": "^8.1.1",
    "vitest": "^5.1.1"
  }
}
